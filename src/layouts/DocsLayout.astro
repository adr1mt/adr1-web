---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Ra1Nav from '../components/Ra1Nav.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import type { Ra1Page } from '../lib/site';

interface Crumb { label: string; url?: string }
interface Link { url: string; ref?: string; title: string }

interface Props {
  title: string;
  description?: string;
  pages: Ra1Page[];
  currentId?: string;
  breadcrumb: Crumb[];
  headings?: MarkdownHeading[];
  prev?: Link;
  next?: Link;
}

const { title, description, pages, currentId, breadcrumb, headings = [], prev, next } = Astro.props;
---

<BaseLayout title={title} description={description} current="serveis" lang="ca">
  <Fragment slot="menu">
    <div class="menu-nav"><Ra1Nav pages={pages} currentId={currentId} /></div>
  </Fragment>

  <div class="docs">
    <aside class="docs-sidebar" data-pagefind-ignore="all">
      <Ra1Nav pages={pages} currentId={currentId} />
    </aside>

    <main id="contingut" class="docs-main" tabindex="-1">
      <nav class="breadcrumb" aria-label="Ruta de navegació" data-pagefind-ignore="all">
        <ol>
          {breadcrumb.map((c) => (
            <li>{c.url ? <a href={c.url}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
      <article class="prose" data-pagefind-body>
        <slot />
      </article>
      <PrevNext prev={prev} next={next} />
    </main>

    <aside class="docs-toc">
      <Toc title={title} headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  /* Three columns as in the reference: grey sidebar glued to the header,
     content column of 50rem plus padding, sticky TOC of 14rem. */
  .docs {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr) var(--toc-w);
    max-width: calc(var(--sidebar-w) + var(--measure) + var(--toc-w) + 4rem);
    margin: 0 auto;
    min-height: calc(100vh - var(--header-h));
  }
  .docs-sidebar {
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.5rem 0.75rem;
    background: var(--bg-soft);
    border-right: 1px solid var(--rule);
  }
  .docs-main { min-width: 0; padding: 2rem 2.5rem; }
  .docs-main:focus { outline: none; }
  .docs-toc {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 1rem);
    overflow-y: auto;
    padding: 1.5rem 0.75rem;
  }

  @media (max-width: 70rem) {
    .docs { grid-template-columns: minmax(0, 1fr); max-width: 100%; }
    .docs-sidebar, .docs-toc { display: none; }
    .docs-main { padding: 1.25rem 1rem; }
  }

  .menu-nav { padding: 1rem 0.75rem; }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .breadcrumb li + li::before { content: '›'; margin-right: 0.4rem; opacity: 0.6; }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb [aria-current] { color: var(--ink); font-weight: 500; }
</style>
