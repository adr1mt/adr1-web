---
import BaseLayout from './BaseLayout.astro';
import { getMicroposts, tagUrl, tagSlug, href } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Tag slug currently filtered, if any. */
  currentTag?: string;
  /** Only permalinks go into the search index, so lists do not duplicate results. */
  searchable?: boolean;
}
const { title, description, currentTag, searchable = false } = Astro.props;

const counts = new Map<string, number>();
for (const p of await getMicroposts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0], 'ca'));
---

<BaseLayout title={title} description={description} current="microblog">
  <div class="microblog">
    <main id="contingut" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <aside class="side" data-pagefind-ignore="all">
      <nav aria-labelledby="tags-title">
        <p class="side-title" id="tags-title">Etiquetes</p>
        <ul>
          <li><a href={href('/microblog/')} aria-current={!currentTag && title === 'Microblog' ? 'page' : undefined}>Totes</a></li>
          {tags.map(([t, n]) => (
            <li>
              <a href={tagUrl(t)} aria-current={currentTag === tagSlug(t) ? 'page' : undefined}>
                {t} <span class="n">{n}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="rss"><a href={href('/microblog/rss.xml')}>Subscriu-t’hi per RSS</a></p>
    </aside>
  </div>
</BaseLayout>

<style>
  .microblog {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: calc(var(--measure) + 16rem);
    margin: 0 auto;
    padding: 2rem var(--gutter) 0;
  }
  main:focus { outline: none; }
  .side { font-size: 0.9375rem; border-top: 1px solid var(--rule); padding-top: 1.5rem; }
  .side-title { margin: 0 0 0.5rem; font-size: 0.8125rem; font-weight: 600; color: var(--muted); }
  .side ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .side a { display: inline-block; padding: 0.375rem 0.625rem; border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .side a:hover { background: var(--bg-soft); }
  .side a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .n { color: var(--muted); font-size: 0.8125rem; }
  .rss { margin: 1.25rem 0 0; }
  .rss a { color: var(--accent); padding-left: 0.625rem; }

  @media (min-width: 64rem) {
    .microblog { grid-template-columns: minmax(0, var(--measure)) 12rem; gap: 4rem; justify-content: space-between; padding-top: 2.5rem; }
    .side { border-top: 0; padding-top: 0; position: sticky; top: calc(var(--header-h) + 2.5rem); align-self: start; }
    .side ul { flex-direction: column; }
    .side a { display: block; }
  }
</style>
