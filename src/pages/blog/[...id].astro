---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getPosts, postUrl, href, type BlogPost as Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const link = (p?: Post) => p && { url: postUrl(p), title: p.data.title };
---

<BlogLayout title={post.data.title} searchable showTags={false}>
  <p class="back" slot="intro" data-pagefind-ignore><a href={href('/blog/')}>← Blog</a></p>
  <PostCard post={post} single />
  <PrevNext slot="after" prev={link(older)} next={link(newer)} />
</BlogLayout>

<style>
  .back { margin: 0 0 1.5rem; font-size: 0.9375rem; }
</style>
