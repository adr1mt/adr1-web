---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/site';

const posts = await getPosts();
---

<BlogLayout title="Blog" description="Recomendaciones técnicas breves: herramientas, recursos y proyectos.">
  <header class="intro" slot="intro">
    <h1 class="page-title">Blog</h1>
    <p class="lede">Recomendaciones breves: herramientas, órdenes, recursos y buenas prácticas que vale la pena conocer.</p>
  </header>
  {posts.map((post) => <PostCard post={post} />)}
</BlogLayout>
