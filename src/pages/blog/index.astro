---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/site';

const posts = await getPosts();
---

<BlogLayout title="Blog" description="Recomanacions tècniques breus per a l’alumnat de Serveis en Xarxa.">
  <header class="intro" slot="intro">
    <h1 class="page-title">Blog</h1>
    <p class="lede">Recomanacions breus: eines, ordres, recursos i bones pràctiques que val la pena conèixer.</p>
  </header>
  {posts.map((post) => <PostCard post={post} />)}
</BlogLayout>
