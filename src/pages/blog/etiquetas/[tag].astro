---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, tagSlug, href, type BlogPost as Post } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const byTag = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    const name = post.data.tag;
    const slug = tagSlug(name);
    if (!byTag.has(slug)) byTag.set(slug, { name, posts: [] });
    byTag.get(slug)!.posts.push(post);
  }
  return [...byTag].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

const { tag } = Astro.params;
const { name, posts } = Astro.props;
---

<BlogLayout title={`${name} · Blog`} currentTag={tag}>
  <header class="intro" slot="intro">
    <p class="eyebrow"><a href={href('/blog/')}>Blog</a></p>
    <h1 class="page-title">{name}</h1>
    <p class="lede">{posts.length} {posts.length === 1 ? 'entrada' : 'entradas'} con esta etiqueta.</p>
  </header>
  {posts.map((post) => <PostCard post={post} />)}
</BlogLayout>
