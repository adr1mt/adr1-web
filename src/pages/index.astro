---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE_TITLE, href, getPosts, postUrl, formatDate } from '../lib/site';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} current="inicio">
  <main id="contingut" class="home" tabindex="-1">
    <h1 class="intro">Web educativa de Adrià, profesor de informática en el Institut Puig Castellar</h1>

    <section aria-labelledby="modulos">
      <h2 id="modulos" class="label">Módulos</h2>
      <a class="module" href={href('/serveis-en-xarxa/')}>
        <span class="module-title" lang="ca">Serveis en Xarxa</span>
        <span class="module-sub" lang="ca">Mòdul 0227 · CFGM SMX</span>
      </a>
    </section>

    {latest.length > 0 && (
      <section aria-labelledby="blog">
        <h2 id="blog" class="label">Blog</h2>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <a class="post" href={postUrl(post)}>
                {post.data.image && <Image class="thumb" src={post.data.image} alt="" widths={[40, 80]} sizes="40px" />}
                <span class="post-title">{post.data.title}</span>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
        <p class="all"><a href={href('/blog/')}>Todas las entradas →</a></p>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .home { max-width: calc(var(--measure) + 4rem); margin: 0 auto; padding: 3rem var(--gutter) 0; }
  .home:focus { outline: none; }
  .intro { font-size: 1.375rem; font-weight: 700; line-height: 1.35; color: var(--ink); text-align: center; max-width: 34rem; margin: 0 auto 1rem; }
  h2 { font-size: 1.375rem; font-weight: 700; margin: 2.5rem 0 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--rule); }
  /* Small blue pill instead of a section heading, as in Pledin. */
  section { text-align: center; }
  .posts { text-align: left; }
  h2.label {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border: 0;
    border-radius: 1rem;
    background: var(--accent-soft);
    color: var(--accent-high);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Same card as the blog posts: the border lights up on hover. */
  .module {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 20rem;
    margin: 0 auto;
    text-align: center;
    padding: 1.25rem;
    background: var(--bg-nav);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .module:hover { border-color: var(--accent); text-decoration: none; }
  .module-title { font-size: 1.125rem; font-weight: 700; color: var(--ink); }
  .module-sub { font-size: 0.875rem; color: var(--muted); }

  /* Latest posts: small cards with only logo, title and date. */
  .posts { display: grid; gap: 0.5rem; max-width: 26rem; margin: 0 auto; padding: 0; list-style: none; }
  .post {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--bg-nav);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .post:hover { border-color: var(--accent); text-decoration: none; }
  .post:not(:has(.thumb)) { grid-template-columns: 1fr; }
  .thumb { grid-row: span 2; width: 2.5rem; height: 2.5rem; object-fit: contain; }
  .post-title { font-weight: 600; color: var(--ink); line-height: 1.3; }
  .post time { font-size: 0.8125rem; color: var(--muted); }
  .all { margin-top: 1.25rem; }
</style>
