---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---

<BaseLayout title="Página no encontrada">
  <main id="contingut" class="nf" tabindex="-1">
    <p class="eyebrow">Error 404</p>
    <h1 class="page-title">Esta página no existe</h1>
    <p>Puede que la dirección haya cambiado. Vuelve al <a href={href('/')}>inicio</a>, abre <a href={href('/serveis-en-xarxa/')}>Serveis en Xarxa</a> o usa la búsqueda.</p>
  </main>
</BaseLayout>

<style>
  .nf { max-width: var(--measure); margin: 0 auto; padding: 4rem var(--gutter) 0; }
</style>
