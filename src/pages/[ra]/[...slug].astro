---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { RAS, getRaPages, pageUrl, sectionOf, SECTIONS, href, raLabel, raUrl, type Ra, type RaPage } from '../../lib/site';

export async function getStaticPaths() {
  const paths = await Promise.all(RAS.map(async (ra) => {
    const pages = await getRaPages(ra.id);
    return pages.map((page) => ({
      params: { ra: ra.id, slug: page.id.slice(ra.id.length + 1) },
      props: { ra, page, pages },
    }));
  }));
  return paths.flat();
}

interface Props { ra: Ra; page: RaPage; pages: RaPage[] }
const { ra, page, pages } = Astro.props;
const { Content, headings } = await render(page);

// Previous / next follow the reading order of the sidebar.
const i = pages.findIndex((p) => p.id === page.id);
const link = (p?: RaPage) => p && { url: pageUrl(p), ref: p.data.ref, title: p.data.title };
const prev = link(pages[i - 1]) ?? { url: raUrl(ra), title: `Índex del RA${ra.n}` };
const next = link(pages[i + 1]);

const section = SECTIONS.find((s) => s.id === sectionOf(page))!;
const breadcrumb = [
  { label: 'Serveis de xarxa', url: href('/serveis-en-xarxa/') },
  { label: raLabel(ra), url: raUrl(ra) },
  { label: section.label, url: `${raUrl(ra)}#${section.id}` },
  { label: `${page.data.ref} · ${page.data.title}` },
];
---

<DocsLayout
  title={`${page.data.ref} · ${page.data.title}`}
  description={page.data.description}
  ra={ra}
  pages={pages}
  currentId={page.id}
  breadcrumb={breadcrumb}
  headings={headings}
  prev={prev}
  next={next}
>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <Content components={{ pre: CodeBlock }} />
</DocsLayout>
