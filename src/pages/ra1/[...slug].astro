---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { getRa1Pages, pageUrl, sectionOf, SECTIONS, href, type Ra1Page } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getRa1Pages();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page, pages } }));
}

interface Props { page: Ra1Page; pages: Ra1Page[] }
const { page, pages } = Astro.props;
const { Content, headings } = await render(page);

// Previous / next follow the reading order of the sidebar.
const i = pages.findIndex((p) => p.id === page.id);
const link = (p?: Ra1Page) => p && { url: pageUrl(p), ref: p.data.ref, title: p.data.title };
const prev = link(pages[i - 1]) ?? { url: href('/ra1/'), title: 'Índex del RA1' };
const next = link(pages[i + 1]);

const section = SECTIONS.find((s) => s.id === sectionOf(page))!;
const breadcrumb = [
  { label: 'M7', url: href('/') },
  { label: 'RA1 · Servei DHCP', url: href('/ra1/') },
  { label: section.label, url: `${href('/ra1/')}#${section.id}` },
  { label: `${page.data.ref} · ${page.data.title}` },
];
---

<DocsLayout
  title={`${page.data.ref} · ${page.data.title}`}
  description={page.data.description}
  pages={pages}
  currentId={page.id}
  breadcrumb={breadcrumb}
  headings={headings}
  prev={prev}
  next={next}
>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <Content components={{ pre: CodeBlock }} />
</DocsLayout>
