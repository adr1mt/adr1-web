---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getRa1Pages, pageUrl, sectionOf, SECTIONS, href } from '../../lib/site';

const pages = await getRa1Pages();
const first = pages[0];
const ref = (r: string) => pageUrl(pages.find((p) => p.data.ref === r)!);
---

<DocsLayout
  title="RA1 · Servei DHCP"
  description="Adreçament, DHCP, encaminament i NAT."
  pages={pages}
  breadcrumb={[{ label: 'Serveis en Xarxa', url: href('/serveis-en-xarxa/') }, { label: 'RA1 · Servei DHCP' }]}
  headings={SECTIONS.map((s) => ({ depth: 2, slug: s.id, text: s.label }))}
  prev={{ url: href('/serveis-en-xarxa/'), title: 'Serveis en Xarxa' }}
  next={{ url: pageUrl(first), ref: first.data.ref, title: first.data.title }}
>
  <h1>RA1 · Instal·lació de serveis de configuració dinàmica (DHCP)</h1>
  <p>Adreçament, DHCP, encaminament i NAT. Tria teoria, guia o activitat segons el que necessitis.</p>

  <p>
    <a href={ref('A1.1')}>A1.1</a> prepara la base; <a href={ref('A1.2')}>A1.2</a> reaprofita el servidor.
    Per a <a href={ref('A1.3')}>A1.3</a> i <a href={ref('A1.4')}>A1.4</a>, parteix d’una còpia neta
    d’<a href={ref('A1.1')}>A1.1</a> o d’una màquina nova.
    L’externa <code>puigcastellar1</code> va per DHCP i la interna <code>personal1</code>, amb IP fixa.
    Treballem al servidor per SSH des de l’amfitrió.
  </p>

  {SECTIONS.map((section) => (
    <section aria-labelledby={section.id}>
      <h2 id={section.id}>{section.label}</h2>
      <p class="section-intro">{section.intro}</p>
      <ul class="index">
        {pages.filter((p) => sectionOf(p) === section.id).map((p) => (
          <li>
            <a href={pageUrl(p)}>
              <span class="ref">{p.data.ref}</span>
              <span class="ttl">{p.data.title}</span>
              <span class="sub">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>

<style>
  .section-intro { color: var(--muted); }
  .index { list-style: none; padding: 0; border-top: 1px solid var(--rule); }
  .index li { margin: 0; border-bottom: 1px solid var(--rule); }
  .index a {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 0.75rem;
    padding: 0.875rem 0.5rem;
    margin: 0 -0.5rem;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .index a:hover { background: var(--bg-soft); text-decoration: none; }
  .ref { font: 0.875rem/1.6 var(--font-mono); color: var(--muted); grid-row: span 2; padding-top: 0.0625rem; }
  .ttl { font-weight: 600; color: var(--accent); }
  .sub { color: var(--muted); font-size: 0.9375rem; grid-column: 2; }
</style>
