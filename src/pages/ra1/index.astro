---
import RaIndex from '../../components/RaIndex.astro';
import { getRa, getRaPages, pageUrl } from '../../lib/site';

const ra = getRa('ra1');
const pages = await getRaPages(ra.id);
const ref = (r: string) => pageUrl(pages.find((p) => p.data.ref === r)!);
---

<RaIndex ra={ra} description="Adreçament, DHCP, encaminament i NAT.">
  <p>
    <a href={ref('A1.1')}>A1.1</a> prepara la base; <a href={ref('A1.2')}>A1.2</a> reaprofita el servidor.
    Per a <a href={ref('A1.3')}>A1.3</a> i <a href={ref('A1.4')}>A1.4</a>, fes servir una màquina nova.
    L’externa <code>puigcastellar1</code> va per DHCP i la interna <code>personal1</code>, amb IP fixa.
    Treballem al servidor per SSH des de l’amfitrió.
  </p>
</RaIndex>
