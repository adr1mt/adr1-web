---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/site';

const tools = [
  { name: 'IPCalc', desc: 'Red, broadcast, rango de hosts y subredes a partir de una IP y su máscara.', url: href('/herramientas/ipcalc/') },
];
---

<BaseLayout title="Herramientas" description="Herramientas web pequeñas para redes y sistemas." current="herramientas">
  <main id="contingut" class="tools-page" tabindex="-1">
    <header class="intro">
      <h1 class="page-title">Herramientas</h1>
      <p class="lede">Utilidades pequeñas para clase y para el día a día. Funcionan en el navegador, sin enviar nada a ningún servidor.</p>
    </header>

    <ul class="list">
      {tools.map((t) => (
        <li>
          <a href={t.url}>
            <span class="name">{t.name}</span>
            <span class="desc">{t.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .tools-page { max-width: calc(var(--measure) + 4rem); margin: 0 auto; padding: 3rem var(--gutter) 0; }
  .tools-page:focus { outline: none; }
  .intro { text-align: center; }
  .intro .lede { margin-inline: auto; }

  .list { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .list a:hover { background: var(--bg-soft); }
  .list a:hover .name { text-decoration: underline; }
  .name { color: var(--accent); font-weight: 600; }
  .desc { color: var(--muted); font-size: 0.95rem; }

  @media (max-width: 30rem) {
    .list a { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
