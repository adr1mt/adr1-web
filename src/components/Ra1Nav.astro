---
import { SECTIONS, sectionOf, pageUrl, href, type Ra1Page } from '../lib/site';

interface Props {
  pages: Ra1Page[];
  currentId?: string;
}
const { pages, currentId } = Astro.props;
---

<nav class="ra1-nav" aria-label="Pàgines del RA1">
  <a class="section-title" href={href('/ra1/')} aria-current={currentId ? undefined : 'page'}>
    RA1 · Servei DHCP
  </a>
  {SECTIONS.map((section) => (
    <div class="section">
      <p class="section-title">{section.label}</p>
      <ul>
        {pages.filter((p) => sectionOf(p) === section.id).map((p) => (
          <li>
            <a href={pageUrl(p)} aria-current={p.id === currentId ? 'page' : undefined}>
              {p.data.ref} · {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<script>
  // Keeps the current page visible in a long sidebar.
  document.querySelector('.docs-sidebar [aria-current="page"]')?.scrollIntoView({ block: 'center' });
</script>

<style>
  .ra1-nav { font-size: 0.875rem; line-height: 1.5; }
  .section { margin-bottom: 1.25rem; }
  .section-title {
    display: block;
    margin: 0 0 0.5rem;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
  }
  a.section-title { margin-bottom: 1.25rem; }
  a.section-title:hover, a.section-title[aria-current='page'] { color: var(--accent); text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a {
    display: block;
    padding: 0.3rem 0.5rem 0.3rem 0.75rem;
    border-left: 2px solid transparent;
    border-radius: 0 0.25rem 0.25rem 0;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  li a:hover {
    color: var(--accent);
    background: var(--rule);
    border-left-color: var(--accent);
    text-decoration: none;
  }
  li a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 600;
  }
</style>
