---
// A numbered sequence of protocol steps (DORA and similar).
interface Props {
  steps: { n: string; t: string; d: string }[];
}
const { steps } = Astro.props;
---

<ol class="flow">
  {steps.map((s) => (
    <li>
      <span class="n" aria-hidden="true">{s.n}</span>
      <span class="t">{s.t}</span>
      <span class="d">{s.d}</span>
    </li>
  ))}
</ol>

<style>
  .flow {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    border: 1px solid var(--rule);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .flow li {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: -1px 0 0 -1px;
    padding: 0.875rem 1rem;
    border-left: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
  }
  .n { font: 0.75rem/1.4 var(--font-mono); color: var(--muted); }
  .t { font: 500 0.9375rem/1.4 var(--font-mono); color: var(--accent); }
  .d { font-size: 0.9375rem; line-height: 1.45; }
</style>
