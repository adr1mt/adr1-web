---
interface Props {
  id: string;
  type: 'single' | 'multi';
  /** Trusted HTML from the course material (may contain <code>, <em>). */
  statement: string;
  explanation?: string;
  options: [string, boolean][];
}
const { id, type, statement, explanation, options } = Astro.props;
const hint = type === 'multi' ? 'Pots triar més d’una resposta.' : 'Tria una resposta.';
---

<fieldset class="question" id={`q-${id}`} data-type={type} data-explanation={explanation}>
  <legend><span set:html={statement} /> <span class="hint">{hint}</span></legend>
  <div class="options">
    {options.map(([html, correct]) => (
      <button type="button" class="option" aria-pressed="false" data-correct={String(correct)} disabled set:html={html} />
    ))}
  </div>
  <div class="actions">
    <button type="button" class="check" disabled>Comprova la resposta</button>
    <button type="button" class="retry" hidden>Torna-ho a provar</button>
  </div>
  <p class="feedback" role="status"></p>
</fieldset>

<style>
  .question {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1rem 1.125rem 0.5rem;
    margin: 0;
    min-width: 0;
  }
  legend { padding: 0; font-weight: 600; float: left; width: 100%; margin-bottom: 0.75rem; }
  .hint { display: block; font-weight: 400; font-size: 0.875rem; color: var(--muted); }
  .options { clear: both; display: flex; flex-direction: column; gap: 0.375rem; }
  .option {
    text-align: left;
    padding: 0.5rem 0.75rem;
    min-height: 2.75rem;
    background: var(--bg);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    cursor: pointer;
    line-height: 1.4;
  }
  .option:hover:not(:disabled) { background: var(--bg-soft); }
  .option[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }
  .option:disabled { cursor: default; }
  .option[data-result='correct'] { border-color: var(--ok); background: var(--ok-soft); }
  .option[data-result='wrong'] { border-color: var(--ko); background: var(--ko-soft); }
  .option :global(.mark) { color: var(--muted); font-size: 0.875rem; }
  .option :global(code) { font: 0.875em var(--font-mono); }

  .actions { margin-top: 0.75rem; }
  .check, .retry {
    font-weight: 600;
    padding: 0.5rem 0.875rem;
    min-height: 2.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .retry { background: none; color: var(--accent); }
  .check:disabled { opacity: 0.5; cursor: default; }
  .feedback { margin: 0.75rem 0 0.5rem; font-size: 0.9375rem; }
  .feedback:empty { margin: 0; }
  .feedback.ok { color: var(--ok); }
  .feedback.ko { color: var(--ko); }
</style>
