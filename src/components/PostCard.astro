---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, postUrl, tagUrl, type BlogPost } from '../lib/site';

interface Props {
  post: BlogPost;
  /** Permalink page: the title is the page h1. */
  single?: boolean;
}
const { post, single = false } = Astro.props;
const { Content } = await render(post);
const Heading = single ? 'h1' : 'h2';
---

<article class:list={['post-card', { single }]}>
  <header>
    <Heading class="title">
      {single ? post.data.title : <a href={postUrl(post)}>{post.data.title}</a>}
    </Heading>
    <p class="meta">
      <span class="date">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      </span>
      <a class="tag" href={tagUrl(post.data.tag)}>{post.data.tag}</a>
    </p>
  </header>
  {post.data.image && (
    <Image
      class="cover"
      src={post.data.image}
      alt={post.data.imageAlt}
      widths={[160, 320]}
      sizes="160px"
      loading={single ? 'eager' : 'lazy'}
    />
  )}
  <div class="prose body">
    <Content />
  </div>
</article>

<style>
  /* Card like the reference blog: the border lights up on hover. */
  .post-card {
    padding: 1.25rem;
    background: var(--bg-nav);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    transition: border-color 0.2s;
  }
  .post-card:hover { border-color: var(--accent); }
  .post-card.single { padding: 2rem; }
  .post-card.single:hover { border-color: var(--rule); }
  .title { font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 0.375rem; text-wrap: balance; }
  .single .title { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem); line-height: 1.2; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--accent); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .date { display: inline-flex; align-items: center; gap: 0.375rem; }
  .tag {
    padding: 0.125rem 0.625rem;
    border-radius: 1rem;
    background: var(--accent-soft);
    color: var(--accent-high);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .tag:hover { background: var(--accent); color: var(--bg); text-decoration: none; }
  /* Small illustration under the title, never a full-width banner. */
  .cover {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 10rem;
    margin: 0 0 1.25rem;
  }
  .body > :global(:last-child) { margin-bottom: 0; }
  @media (max-width: 30rem) {
    .post-card, .post-card.single { padding: 1rem; }
  }
</style>
