---
// Replaces every <pre> rendered from Markdown code fences (see `components` in the RA1 page).
// Shows the fence title ("Terminal", "Fitxer JSON · Kea") and a copy button.
const { 'data-title': title, 'data-language': lang, ...attrs } = Astro.props;
const label = title ?? (lang && lang !== 'plaintext' && lang !== 'text' ? lang.toUpperCase() : 'Codi');
const terminal = label.startsWith('Terminal');
---

<div class:list={['code', { terminal }]}>
  <div class="code-head">
    <span class="code-label">{label}</span>
    <button type="button" class="copy" hidden>Copia<span class="visually-hidden"> el codi: {label}</span></button>
    <span class="copy-status visually-hidden" role="status"></span>
  </div>
  <pre {...attrs} data-language={lang}><slot /></pre>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.code').forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('.copy')!;
    const status = block.querySelector<HTMLElement>('.copy-status')!;
    const pre = block.querySelector('pre')!;
    if (!navigator.clipboard) return;
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.firstChild!.textContent = 'Copiat';
        status.textContent = 'Codi copiat al porta-retalls.';
      } catch {
        button.firstChild!.textContent = 'No s’ha pogut copiar';
        status.textContent = 'No s’ha pogut copiar. Selecciona el codi i copia’l amb el teclat.';
      }
      timer = window.setTimeout(() => {
        button.firstChild!.textContent = 'Copia';
        status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .code { margin: 1.25rem 0 1.5rem; }
  .code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.375rem;
    min-height: 2rem;
  }
  .code-label { font: 0.75rem/1.2 var(--font-mono); color: var(--muted); }
  .terminal .code-label::before { content: '$ '; color: var(--rule-strong); }
  .copy {
    font: 600 0.8125rem/1 var(--font-body);
    color: var(--muted);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.375rem 0.625rem;
    min-height: 2rem;
    cursor: pointer;
  }
  .copy:hover { color: var(--ink); border-color: var(--rule-strong); }
  .code pre { margin: 0; }
</style>
