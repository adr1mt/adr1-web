---
// Replaces every <pre> rendered from Markdown code fences (see `components` in the RA1 page).
// Shows the fence title ("Terminal", "Fitxer JSON · Kea") and a copy button.
const { 'data-title': title, 'data-language': lang, ...attrs } = Astro.props;
const label = title ?? (lang && lang !== 'plaintext' && lang !== 'text' ? lang.toUpperCase() : 'Codi');
const terminal = label.startsWith('Terminal');
// JSON files are always shown on a dark background, also with the light theme.
const dark = lang === 'json';
---

<div class:list={['code', { terminal, dark }]}>
  <p class="code-label">{label}</p>
  <div class="code-body">
    <pre {...attrs} data-language={lang}><slot /></pre>
    <button type="button" class="copy" aria-label={`Copia el codi: ${label}`} hidden>
      <svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
      <svg class="icon-done" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
    </button>
    <span class="copy-status visually-hidden" role="status"></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.code').forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('.copy')!;
    const status = block.querySelector<HTMLElement>('.copy-status')!;
    const pre = block.querySelector('pre')!;
    if (!navigator.clipboard) return;
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.dataset.done = '';
        status.textContent = 'Codi copiat al porta-retalls.';
      } catch {
        status.textContent = 'No s’ha pogut copiar. Selecciona el codi i copia’l amb el teclat.';
      }
      timer = window.setTimeout(() => {
        delete button.dataset.done;
        status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .code { margin: 1.25rem 0; }
  .code-label { margin: 0 0 0.25rem; font: 0.75rem/1.4 var(--font-mono); color: var(--muted); }
  .terminal .code-label::before { content: '$ '; }
  .code-body { position: relative; }
  .code pre { margin: 0; }
  .code pre:has(+ .copy:not([hidden])) { padding-right: 3rem; }
  .copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    color: var(--muted);
    background: var(--rule);
    border: 1px solid var(--control);
    border-radius: 0.25rem;
    cursor: pointer;
  }
  .copy:hover { color: var(--bg); background: var(--muted); }
  .copy[hidden] { display: none; }
  .dark .copy { color: #CDD6F4; background: #2A3646; border-color: #526174; }
  .dark .copy:hover { color: #16202E; background: #CDD6F4; }
  .icon-done, .copy[data-done] .icon-copy { display: none; }
  .copy[data-done] .icon-done { display: block; }
</style>
