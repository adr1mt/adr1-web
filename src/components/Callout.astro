---
// Marks a passage the student should not miss. The tone comes from `kind`;
// the section heading stays outside, so it is still part of the TOC.
interface Props {
  kind: 'recordatori' | 'bones pràctiques' | 'nota';
}
const { kind } = Astro.props;
const tone = { recordatori: 'warn', 'bones pràctiques': 'ok', nota: 'info' }[kind];
const label = kind[0].toUpperCase() + kind.slice(1);
---

<aside class:list={['callout', tone]} aria-label={label}>
  <p class="callout-title">{label}</p>
  <slot />
</aside>

<style>
  .callout {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid;
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .callout > :global(:last-child) { margin-bottom: 0; }
  .callout :global(p) { margin-bottom: 0.5rem; }
  .callout-title { font-weight: 700; font-size: 0.9rem; margin: 0 0 0.5rem; }
  .info { border-color: #3B82F6; background: var(--accent-soft); }
  .info .callout-title { color: var(--accent-high); }
  .warn { border-color: #F59E0B; background: var(--warn-soft); }
  .warn .callout-title { color: var(--warn); }
  .ok { border-color: #10B981; background: var(--ok-soft); }
  .ok .callout-title { color: var(--ok); }
</style>
