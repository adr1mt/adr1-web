---
import { render } from 'astro:content';
import { formatDate, postUrl, tagUrl, type Micropost } from '../lib/site';

interface Props {
  post: Micropost;
  /** Permalink page: the title is the page h1. */
  single?: boolean;
}
const { post, single = false } = Astro.props;
const { Content } = await render(post);
const Heading = single ? 'h1' : 'h2';
---

<article class:list={['micropost', { single }]}>
  <header>
    <Heading class="title">
      {single ? post.data.title : <a href={postUrl(post)}>{post.data.title}</a>}
    </Heading>
    <p class="meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      {post.data.tags.length > 0 && (
        <span class="tags">
          {post.data.tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}
        </span>
      )}
    </p>
  </header>
  <div class="prose body">
    <Content />
  </div>
</article>

<style>
  .micropost { padding: 2rem 0; border-bottom: 1px solid var(--rule); }
  .micropost.single { padding-top: 0; border-bottom: 0; }
  .title { font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin: 0 0 0.375rem; text-wrap: balance; }
  .single .title { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem); line-height: 1.2; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { text-decoration: underline; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .tags a { color: var(--muted); font-family: var(--font-mono); font-size: 0.8125rem; }
  .tags a:hover { color: var(--accent); }
  .body > :global(:last-child) { margin-bottom: 0; }
</style>
