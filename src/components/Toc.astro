---
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  headings: MarkdownHeading[];
}
const { title, headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav class="toc" aria-labelledby="toc-title" data-pagefind-ignore="all">
    <p class="toc-title" id="toc-title">En aquesta pàgina</p>
    <ul>
      <li class="top"><a href="#">{title}</a></li>
      {items.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
)}

<script>
  // Marks the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc li:not(.top) a')];
  if (links.length) {
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    const mark = () => {
      const line = window.innerHeight * 0.3;
      let current = -1;
      targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < line) current = i; });
      links.forEach((a, i) => a.toggleAttribute('data-active', i === current));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>

<style>
  .toc { border-left: 2px solid var(--rule); padding-left: 1rem; }
  .toc-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  a {
    display: block;
    margin-left: -1.1rem;
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
  }
  a:hover, a[data-active] {
    color: var(--accent);
    background: var(--bg-soft);
    border-left-color: var(--accent);
    text-decoration: none;
  }
  .top a { font-weight: 700; color: var(--ink); }
  .depth-2 { padding-left: 0.75rem; }
  .depth-3 { padding-left: 1.75rem; }
</style>
