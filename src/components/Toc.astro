---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** "aside": sticky column on wide screens. "inline": collapsible block above the content. */
  variant: 'aside' | 'inline';
}
const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 1 && (
  variant === 'aside' ? (
    <nav class="toc toc-aside" aria-labelledby="toc-title" data-pagefind-ignore="all">
      <p class="toc-title" id="toc-title">En aquesta pàgina</p>
      <ol>
        {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  ) : (
    <details class="toc toc-inline" data-pagefind-ignore="all">
      <summary>En aquesta pàgina <span class="count">· {items.length} apartats</span></summary>
      <ol>
        {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </details>
  )
)}

<script>
  // Marks the section being read in the side TOC.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-aside a')];
  if (links.length) {
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    const mark = () => {
      const line = window.innerHeight * 0.3;
      let current = 0;
      targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < line) current = i; });
      links.forEach((a, i) => a.toggleAttribute('data-active', i === current));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>

<style>
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc a { color: var(--muted); text-decoration: none; display: block; }
  .toc a:hover { color: var(--ink); }

  .toc-aside { font-size: 0.875rem; line-height: 1.4; }
  .toc-title { margin: 0 0 0.75rem; font-size: 0.8125rem; font-weight: 600; color: var(--muted); }
  .toc-aside ol { border-left: 1px solid var(--rule); }
  .toc-aside a { padding: 0.3125rem 0 0.3125rem 0.875rem; margin-left: -1px; border-left: 2px solid transparent; }
  .toc-aside a[data-active] { color: var(--accent); border-left-color: var(--accent); }

  .toc-inline {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    margin: 0 0 2rem;
    font-size: 0.9375rem;
  }
  .toc-inline summary {
    cursor: pointer;
    padding: 0.625rem 0.875rem;
    min-height: 2.75rem;
    font-weight: 600;
  }
  .count { color: var(--muted); font-weight: 400; }
  .toc-inline ol { padding: 0 0.875rem 0.75rem; }
  .toc-inline a { padding: 0.375rem 0; }
</style>
