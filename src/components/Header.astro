---
import { SITE_TITLE, MODULE, href } from '../lib/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const links = [
  { id: 'ra1', label: 'RA1 · DHCP', url: href('/ra1/') },
  { id: 'microblog', label: 'Microblog', url: href('/microblog/') },
];
---

<header class="site-header" data-pagefind-ignore="all">
  <div class="bar">
    <button type="button" class="icon-btn menu-btn" aria-label="Obre el menú" aria-haspopup="dialog" data-menu-open>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none" /></svg>
    </button>

    <a class="brand" href={href('/')}>
      <span class="brand-name">{SITE_TITLE}</span>
      <span class="brand-module">{MODULE}</span>
    </a>

    <nav class="main-nav" aria-label="Seccions">
      {links.map((l) => (
        <a href={l.url} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="tools">
      <button type="button" class="search-btn" data-search-open aria-label="Cerca al web">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75" fill="none" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
        <span class="search-label">Cerca</span>
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Tema fosc" aria-pressed="false">
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>

  <dialog class="menu" aria-label="Menú">
    <div class="menu-head">
      <span class="menu-title">Menú</span>
      <button type="button" class="icon-btn" aria-label="Tanca el menú" data-menu-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
      </button>
    </div>
    <nav aria-label="Seccions" class="menu-sections">
      <a href={href('/')}>Inici</a>
      {links.map((l) => (
        <a href={l.url} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <slot />
  </dialog>

  <pagefind-config bundle-path={href('/pagefind/')} lang="ca"></pagefind-config>
  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</header>

<script>
  // ----- Theme -----
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncTheme = () => {
    const dark = root.dataset.theme === 'dark';
    themeBtn.setAttribute('aria-pressed', String(dark));
  };
  syncTheme();
  themeBtn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('tema', root.dataset.theme); } catch {}
    syncTheme();
  });

  // ----- Menu (native <dialog>: focus trap and Esc for free) -----
  const menu = document.querySelector<HTMLDialogElement>('dialog.menu')!;
  document.querySelector('[data-menu-open]')!.addEventListener('click', () => menu.showModal());
  document.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
  menu.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
  // Closing on in-page links (TOC anchors) so the target is visible.
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a[href^="#"]')) menu.close();
  });
  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => { if (e.matches) menu.close(); });

  // ----- Search: Pagefind UI is loaded only the first time it is needed -----
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let loading: Promise<void> | undefined;
  function loadSearch() {
    loading ??= new Promise<void>((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}/pagefind/pagefind-component-ui.css`;
      document.head.append(css);
      const js = document.createElement('script');
      js.type = 'module';
      js.src = `${base}/pagefind/pagefind-component-ui.js`;
      js.onerror = () => { loading = undefined; reject(); };
      document.head.append(js);
      customElements.whenDefined('pagefind-modal').then(() => resolve());
    });
    return loading;
  }
  async function openSearch() {
    try {
      await loadSearch();
      (document.querySelector('pagefind-modal') as HTMLElement & { open(): void }).open();
    } catch {
      alert('La cerca només funciona a la versió construïda del web (npm run build).');
    }
  }
  document.querySelector('[data-search-open]')!.addEventListener('click', openSearch);
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: var(--header-h);
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
  }
  .brand-name { font: 500 1.0625rem/1 var(--font-display); white-space: nowrap; }
  .brand-module { font: 0.75rem/1 var(--font-mono); color: var(--muted); white-space: nowrap; }

  .main-nav { display: none; gap: 0.25rem; margin-left: 1.5rem; }
  .main-nav a, .menu-sections a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius);
  }
  .main-nav a:hover, .menu-sections a:hover { color: var(--ink); background: var(--bg-soft); }
  .main-nav a[aria-current='page'], .menu-sections a[aria-current='page'] { color: var(--ink); font-weight: 600; }

  .tools { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }

  .icon-btn, .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover, .search-btn:hover { color: var(--ink); background: var(--bg-soft); }
  .search-btn { border-color: var(--rule); height: 2.25rem; min-width: 2.75rem; }
  .search-label { display: none; font-size: 0.9375rem; }
  [data-theme-toggle][aria-pressed='true'] { color: var(--accent); }

  .menu-btn { margin-left: -0.5rem; }

  @media (min-width: 40rem) {
    .search-label { display: inline; }
    .search-btn { padding: 0 0.75rem; min-width: 8rem; justify-content: flex-start; }
  }
  @media (min-width: 64rem) {
    .menu-btn { display: none; }
    .main-nav { display: flex; }
  }
  @media (max-width: 26rem) {
    .brand-module { display: none; }
  }

  /* Mobile menu */
  .menu {
    margin: 0;
    width: min(22rem, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0 0 2rem;
    border: 0;
    border-right: 1px solid var(--rule);
    background: var(--bg);
    color: var(--ink);
    overflow-y: auto;
  }
  .menu::backdrop { background: rgb(10 15 20 / 0.45); }
  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 0.5rem 0 var(--gutter);
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    background: var(--bg);
  }
  .menu-title { font-weight: 600; }
  .menu-sections {
    display: flex;
    flex-direction: column;
    padding: 0.75rem calc(var(--gutter) - 0.625rem);
    border-bottom: 1px solid var(--rule);
  }
  .menu-sections a { padding: 0.625rem; }

  /* Pagefind modal, using the site tokens */
  pagefind-modal {
    --pf-font: var(--font-body);
    --pf-text: var(--ink);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--muted);
    --pf-background: var(--bg);
    --pf-border: var(--rule-strong);
    --pf-border-focus: var(--accent);
    --pf-hover: var(--bg-soft);
    --pf-mark: var(--ink);
    --pf-skeleton: var(--bg-soft);
    --pf-skeleton-shine: var(--rule);
    --pf-outline-focus: var(--focus);
    --pf-border-radius: var(--radius);
  }
</style>
