---
import { SITE_TITLE, href } from '../lib/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const links = [
  { id: 'inicio', label: 'Inicio', url: href('/') },
  { id: 'serveis', label: 'Serveis en Xarxa', url: href('/serveis-en-xarxa/') },
  { id: 'blog', label: 'Blog', url: href('/blog/') },
];
---

<header class="site-header" data-pagefind-ignore="all">
  <div class="bar">
    <a class="brand" href={href('/')}>
      <img src={href('/logo.png')} alt="" width="32" height="32" />
      <span>{SITE_TITLE}</span>
    </a>

    <nav class="main-nav" aria-label="Secciones">
      {links.map((l) => (
        <a href={l.url} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="tools">
      <button type="button" data-search-open aria-label="Buscar en la web (Ctrl+K)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
      </button>
      <button type="button" data-theme-toggle aria-label="Tema oscuro" aria-pressed="false">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><path d="M12 1v2m0 18v2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M1 12h2m18 0h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
      </button>
      <button type="button" class="menu-btn" aria-label="Abrir el menú" aria-haspopup="dialog" data-menu-open>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>

  <dialog class="menu" aria-label="Menú">
    <div class="menu-head">
      <span class="menu-title">Menú</span>
      <button type="button" aria-label="Cerrar el menú" data-menu-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <nav aria-label="Secciones" class="menu-sections">
      {links.map((l) => (
        <a href={l.url} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <slot />
  </dialog>

  <pagefind-config bundle-path={href('/pagefind/')} lang="es"></pagefind-config>
  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</header>

<script>
  // ----- Theme -----
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncTheme = () => {
    const dark = root.dataset.theme === 'dark';
    themeBtn.setAttribute('aria-pressed', String(dark));
  };
  syncTheme();
  themeBtn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('tema', root.dataset.theme); } catch {}
    syncTheme();
  });

  // ----- Menu (native <dialog>: focus trap and Esc for free) -----
  const menu = document.querySelector<HTMLDialogElement>('dialog.menu')!;
  document.querySelector('[data-menu-open]')!.addEventListener('click', () => menu.showModal());
  document.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
  menu.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
  // Closing on in-page links (TOC anchors) so the target is visible.
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a[href^="#"]')) menu.close();
  });
  matchMedia('(min-width: 70rem)').addEventListener('change', (e) => { if (e.matches) menu.close(); });

  // ----- Search: Pagefind UI is loaded only the first time it is needed -----
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let loading: Promise<void> | undefined;
  function loadSearch() {
    loading ??= new Promise<void>((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}/pagefind/pagefind-component-ui.css`;
      document.head.append(css);
      const js = document.createElement('script');
      js.type = 'module';
      js.src = `${base}/pagefind/pagefind-component-ui.js`;
      js.onerror = () => { loading = undefined; reject(); };
      document.head.append(js);
      customElements.whenDefined('pagefind-modal').then(() => resolve());
    });
    return loading;
  }
  async function openSearch() {
    try {
      await loadSearch();
      (document.querySelector('pagefind-modal') as HTMLElement & { open(): void }).open();
    } catch {
      alert('La búsqueda solo funciona en la versión construida de la web (npm run build).');
    }
  }
  document.querySelector('[data-search-open]')!.addEventListener('click', openSearch);
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: var(--bg-nav);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: calc(var(--sidebar-w) + var(--measure) + 4rem);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--accent-high);
    text-decoration: none;
  }
  .brand:hover { color: var(--accent-high); text-decoration: none; }

  .main-nav { display: flex; flex: 1; justify-content: center; gap: 1.5rem; margin: 0 1rem; }
  .main-nav a, .menu-sections a {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .main-nav a:hover, .menu-sections a:hover,
  .main-nav a[aria-current='page'], .menu-sections a[aria-current='page'] { color: var(--accent-high); text-decoration: none; }

  .tools { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
  .tools button, .menu-head button {
    display: flex;
    align-items: center;
    padding: 4px;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .tools button:hover, .menu-head button:hover { color: var(--accent-high); }

  .moon { display: none; }
  [data-theme-toggle][aria-pressed='true'] .sun { display: none; }
  [data-theme-toggle][aria-pressed='true'] .moon { display: block; }

  .tools .menu-btn { display: none; }
  @media (max-width: 70rem) {
    .bar { max-width: 100%; }
    .tools .menu-btn { display: flex; }
  }
  @media (max-width: 64rem) {
    .main-nav { display: none; }
  }
  @media (max-width: 30rem) {
    .bar { padding: 0 1rem; }
    .tools { gap: 0.5rem; }
  }
  @media (max-width: 24rem) {
    .brand { font-size: 1.15rem; }
    .brand img { width: 26px; height: 26px; }
  }

  /* Mobile menu: a panel under the header, like the reference dropdown. */
  .menu {
    margin: 0;
    width: 100%;
    max-width: none;
    max-height: 100dvh;
    padding: 0 0 1rem;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-nav);
    color: var(--ink);
    overflow-y: auto;
  }
  .menu::backdrop { background: rgb(15 23 42 / 0.4); }
  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .menu-title { font-weight: 700; }
  .menu-sections {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .menu-sections a { font-size: 1rem; }

  /* Pagefind modal, using the site tokens */
  pagefind-modal {
    --pf-font: var(--font-body);
    --pf-text: var(--ink);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--muted);
    --pf-background: var(--bg);
    --pf-border: var(--rule-strong);
    --pf-border-focus: var(--accent);
    --pf-hover: var(--bg-soft);
    --pf-mark: var(--ink);
    --pf-skeleton: var(--bg-soft);
    --pf-skeleton-shine: var(--rule);
    --pf-outline-focus: var(--focus);
    --pf-border-radius: var(--radius);
  }
</style>
